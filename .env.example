# ListenFeed environment variables.
# Copy to .env.local for local development. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# Public media delivery (client-side; inlined into the static build)
# ---------------------------------------------------------------------------
# Public base URL of the optimized media bucket. lib/media.ts prepends this to
# every relative audio path (e.g. /audio/<hash>/speech.mp3). Must be a PUBLIC
# URL: either the bucket's r2.dev public URL (https://pub-XXXX.r2.dev) or a
# connected custom domain (https://media.listenfeed.online). Leave empty to
# serve audio from the local /public bundle instead.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Public base URL for the paginated feed snapshots (feed/latest.json, feed/page-*.json).
# Defaults to NEXT_PUBLIC_MEDIA_BASE_URL when empty; set only if the feed lives on a
# different bucket/domain than the audio.
NEXT_PUBLIC_FEED_BASE_URL=

# ---------------------------------------------------------------------------
# R2 credentials for ops/CMS scripts ONLY (server-side; never exposed to the
# browser). Used by scripts/*.mjs to upload audio and configure the bucket.
# In Cloud Agents / CI these come from Secrets, not this file.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_MASTERS=
# S3 API endpoint used by the SDK for signed reads/writes. This is NOT a public
# URL; do not use it for NEXT_PUBLIC_MEDIA_BASE_URL.
R2_PUBLIC_BASE_URL=
